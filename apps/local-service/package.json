{
  "name": "@earth-stories/local-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/standalone.d.ts",
      "default": "./dist/service.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "yarn --cwd ../.. tsc --build apps/local-service/tsconfig.json --force --pretty false && node scripts/build.mjs",
    "dev": "node --import tsx src/standalone.ts",
    "start": "node dist/service.js"
  },
  "dependencies": {
    "@earth-stories/project-store": "workspace:*",
    "@earth-stories/publisher": "workspace:*",
    "@earth-stories/story-schema": "workspace:*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "esbuild": "~0.28.0",
    "tsx": "^4.20.5"
  }
}
