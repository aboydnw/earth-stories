{
  "name": "@earth-stories/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "earth-stories-mcp": "./dist/mcp.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "yarn --cwd ../.. tsc --build apps/mcp/tsconfig.json --force --pretty false && node scripts/build.mjs",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/mcp.js"
  },
  "dependencies": {
    "@earth-stories/story-schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "~0.28.0",
    "tsx": "^4.20.5"
  }
}
