{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "references": [
    { "path": "../../packages/story-schema" },
    { "path": "../../packages/viewer" },
    { "path": "../../packages/publisher" }
  ],
  "include": ["src", "vite.config.ts"]
}
