{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-stories.dev/schema/conversion/v1.json",
  "title": "Earth Stories conversion protocol v1",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "earth-stories/conversion/v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "inspect",
            "configure",
            "prepare",
            "verify"
          ]
        },
        "capability": {
          "type": "string",
          "enum": [
            "core",
            "vector",
            "raster",
            "multidim",
            "pointcloud"
          ]
        },
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mediaType": {
              "default": null,
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "path",
            "filename",
            "sizeBytes",
            "mediaType"
          ],
          "additionalProperties": false
        },
        "options": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "protocol",
        "requestId",
        "projectId",
        "operation",
        "capability",
        "input",
        "options"
      ],
      "additionalProperties": false
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "const": "earth-stories/conversion/v1"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "progress"
            },
            "stage": {
              "type": "string",
              "enum": [
                "queued",
                "provisioning",
                "inspecting",
                "preparing",
                "verifying"
              ]
            },
            "completed": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "bytes",
                "features",
                "steps"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "protocol",
            "requestId",
            "type",
            "stage",
            "completed",
            "total",
            "unit",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "const": "earth-stories/conversion/v1"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "result"
            },
            "status": {
              "type": "string",
              "const": "succeeded"
            },
            "output": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "warnings": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "protocol",
            "requestId",
            "type",
            "status",
            "output",
            "tools",
            "warnings"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "const": "earth-stories/conversion/v1"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "failure"
            },
            "status": {
              "type": "string",
              "enum": [
                "failed",
                "cancelled"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "protocol",
            "requestId",
            "type",
            "status",
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  ]
}
