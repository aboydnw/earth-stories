{
  "name": "earth-stories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @earth-stories/viewer-app build && concurrently --kill-others --names service,editor \"yarn workspace @earth-stories/local-service dev\" \"yarn workspace @earth-stories/editor dev\"",
    "build": "yarn workspace @earth-stories/editor build && yarn workspace @earth-stories/viewer-app build",
    "build:publication": "yarn workspace @earth-stories/publisher build:fixture",
    "check:independence": "node scripts/check-independence.mjs",
    "check:ui": "node scripts/check-ui-tokens.mjs",
    "contract:generate": "node --import tsx scripts/generate-conversion-contract.ts",
    "conversion:smoke": "node scripts/smoke-conversion-tools.mjs",
    "clean:types": "tsc --build --clean",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^10.5.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
