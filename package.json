{
  "name": "earth-stories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names service,editor \"yarn workspace @earth-stories/local-service dev\" \"yarn workspace @earth-stories/editor dev\"",
    "build": "yarn workspace @earth-stories/editor build && yarn workspace @earth-stories/viewer-app build",
    "build:publication": "yarn workspace @earth-stories/publisher build:fixture",
    "check:independence": "node scripts/check-independence.mjs",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
